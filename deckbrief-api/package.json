{
  "name": "deckbrief-api",
  "version": "1.0.0",
  "description": "DeckBrief CRM backend — lead capture, AI follow-ups, daily brief",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node db/migrate.js",
    "seed:dev": "node scripts/seed-dev.js",
    "brief": "node jobs/daily-brief.js",
    "brief:dry": "node -e \"process.env.DRY_RUN='1';require('./jobs/daily-brief.js')\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "verify": "node test/verify-schema.js",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "pg": "^8.11.5",
    "resend": "^3.2.0"
  }
}
