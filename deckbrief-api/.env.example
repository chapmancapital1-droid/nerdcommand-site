# Copy to .env for local:  copy .env.example .env

# Local Docker Compose (docker compose up -d)
DATABASE_URL=postgresql://deckbrief:deckbrief@localhost:5432/deckbrief

# Master super-admin key (openssl rand -hex 32)
API_SECRET_KEY=dev-master-key-change-me-in-production

# Optional for full AI + email path (lead capture works without them)
