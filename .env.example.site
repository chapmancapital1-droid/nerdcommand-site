# Vercel/server-side AI routing.
# mock: return a safe prototype response.
# gateway: forward to a NerdCommand OS AI Gateway reachable from Vercel.
AI_MODE=mock
NERDCOMMAND_AI_GATEWAY_URL=
NERDCOMMAND_AI_GATEWAY_TOKEN=
NERDCOMMAND_AI_DEFAULT_MODEL=

# Local AI node settings. These are used by connector/local-ai-node.mjs.
# ollama default: http://127.0.0.1:11434/v1
# lmstudio default: http://127.0.0.1:1234/v1
LOCAL_AI_PROVIDER=ollama
LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_AI_MODEL=
LOCAL_AI_ALLOWED_MODELS=
LOCAL_AI_MAX_PROMPT_CHARS=40000
LOCAL_AI_API_KEY=ollama
LOCAL_AI_NODE_PORT=8787

# Production connector mode. The local node will claim jobs over outbound HTTPS.
NERDCOMMAND_OS_URL=
NERDCOMMAND_NODE_ID=
NERDCOMMAND_NODE_TOKEN=
NERDCOMMAND_NODE_POLL_MS=2500
